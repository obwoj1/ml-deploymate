# Copy to .env and fill in. Never commit .env.
# LLM provider: fill in ONE of these keys (whichever account you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-opus-5-5
DATABASE_URL=sqlite:///./deploymate.db
# When true (or no API key set), the LLM layer returns template-based fallbacks so the demo never breaks.
LLM_OFFLINE_MODE=false
